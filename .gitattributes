# Normalise line endings: LF in the repo and in every working tree, so the
# Go files and shell scripts stay byte-identical on Windows and in Linux CI
# / Docker builds (CRLF breaks `gofmt -l` and `bash`).
* text=auto eol=lf

*.go   text eol=lf
*.sh   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
